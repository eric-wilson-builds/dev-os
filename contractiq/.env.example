# =============================================================================
# ContractIQ — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=              # Supabase project URL — Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # Supabase anon/public key — Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=             # SERVER ONLY — Project Settings > API. Never expose to the client; used only in Route Handlers that must bypass RLS (e.g. the retention sweep job)

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=                        # SERVER ONLY — platform.openai.com/api-keys. Used exclusively in lib/openai/* Route Handlers, never sent to the browser
OPENAI_ORG_ID=                         # SERVER ONLY — optional, platform.openai.com/settings (only needed if your account belongs to multiple orgs)

# --- App / Deployment --------------------------------------------------------
NEXT_PUBLIC_APP_URL=                   # e.g. http://localhost:3000 in dev, https://contractiq.app in prod — used to build signed-URL redirects and email links
CRON_SECRET=                           # SERVER ONLY — shared secret checked by the retention-sweep Route Handler so only Vercel Cron can trigger it (Vercel Project Settings > Cron Jobs sets this header automatically)

# --- Rate Limiting -------------------------------------------------------------
# No external service required — rate limiting is backed by the rate_limit_events
# Postgres table (see docs/specs/supabase-schema.sql) via the existing Supabase
# connection, so no additional env vars are needed here.

# --- Security ------------------------------------------------------------------
MAX_CHAT_HISTORY=200                   # Max chat_messages rows fetched from the DB per chat turn to build the LLM prompt (lib/security/tokenLimiter.ts). Optional — defaults to 200 if unset.
